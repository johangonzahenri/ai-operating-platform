# ==============================================================================
# AI OPERATING PLATFORM — CONFIGURACIÓN DE ENTORNO (TEMPLATE)
# Copie este archivo a .env para personalizar variables de entorno.
# NOTA: NUNCA guarde secretos reales ni contraseñas en este archivo de plantilla.
# ==============================================================================

# Entorno de ejecución: development | test | staging | production
NODE_ENV=development

# Enlace de Red y Puerto (Default seguro: 127.0.0.1)
# En producción, HOST=0.0.0.0 requiere ALLOW_PUBLIC_BINDING=true explícito.
HOST=127.0.0.1
PORT=3000
ALLOW_PUBLIC_BINDING=false

# URL Base pública para clientes externos (ej. https://api.tuempresa.com)
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Nivel de Registro: debug | info | warn | error
LOG_LEVEL=info

# Driver de Persistencia: sqlite | memory
PERSISTENCE_DRIVER=sqlite
SQLITE_DB_PATH=data/app.db

# Configuración de Modelos de IA
MODEL_PROVIDER=stub
MODEL_NAME=deterministic-stub

# Gobernanza de Proxy Reverso (Nginx / Caddy / Envoy)
# Establezca TRUST_PROXY=true solo cuando el servidor esté detrás de un proxy confiable.
TRUST_PROXY=false
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Seguridad CORS (Orígenes permitidos separados por coma, o vacío para mismo origen)
# En desarrollo: localhost y 127.0.0.1 están habilitados por defecto.
# En producción: especifique los orígenes exactos (ej. https://app.tuempresa.com).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Validación de Encabezado Host (Hosts permitidos separados por coma, o vacío para omitir)
ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000

# Timeouts y Límites de Carga
TIMEOUT_REQUEST_MS=30000
TIMEOUT_HEADERS_MS=15000
TIMEOUT_KEEP_ALIVE_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
MAX_PAYLOAD_SIZE_BYTES=1048576

# Límites de Tasa (Rate Limiting)
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
