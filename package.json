{
  "name": "ai-operating-platform",
  "version": "1.4.0",
  "private": true,
  "description": "Operational infrastructure foundation for AI systems.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "node scripts/test.js",
    "docs:check": "node scripts/docs-check.mjs",
    "api:check": "node scripts/validate-openapi.mjs",
    "excel:sync": "python scripts/generate_roadmap_excel.py",
    "create-aop-app": "tsx src/platform-client/create-aop-app.ts",
    "check": "npm run build && npm test && npm run api:check && npm run docs:check",
    "start": "npm run build && node dist/src/platform/server.js"
  },
  "bin": {
    "create-aop-app": "dist/src/platform-client/create-aop-app.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
